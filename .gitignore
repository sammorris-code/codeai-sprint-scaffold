.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# Python
__pycache__/
*.pyc
.venv/

# Secrets. Never commit these. This repository is public.
# service/.env is where the Anthropic API key goes; see service/README.md.
.env
.env.*
*.pem
*.key
# The example file carries no real value and is meant to be tracked.
!.env.example

# Real standards documents. Work with them locally; they are not committed.
# service/sample_documents/ is the committed one, and holds only DEMO data.
service/documents/*
!service/documents/README.md

# The extracted curriculum corpus, and the clone it comes from. Both are
# derived from an upstream repository, both are large, and 133 of the links
# inside the corpus point at answer keys restricted to verified teachers.
# Rebuild it with service/extract_curriculum.py; never commit it here.
out/
corpus/
cdo/

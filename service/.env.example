# Copy this file to service/.env and put your real key in it.
#
#   cp service/.env.example service/.env
#
# service/.env is ignored by git and must never be committed. This repository
# is public, and a key pushed here is a key you have to revoke.
#
# Only boundary drafting uses this. The service starts without it, and
# characterizing a document works without it. Ingest returns a 503 that says
# what is missing.

ANTHROPIC_API_KEY=paste-your-key-here

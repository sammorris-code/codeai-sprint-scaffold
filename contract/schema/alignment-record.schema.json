{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alignment-record.schema.json",
  "title": "Alignment record",
  "description": "One (standard, lesson) pair. There is no record for a standard the course misses.",
  "type": "object",
  "required": ["id", "lesson", "level", "evidence", "review_status", "lesson_content_hash"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "integer"},
    "standard_id": {"type": "integer"},
    "lesson": {"$ref": "lesson.schema.json"},
    "level": {"enum": ["introduced", "developed", "mastered"],
      "description": "This lesson's contribution. not_addressed lives on the outcome."},
    "evidence": {"type": "string", "minLength": 1,
      "description": "The specific student task. 'The lesson is about this' is not evidence."},
    "note": {"type": ["string", "null"]},
    "authorship": {"type": ["string", "null"],
      "enum": ["student_authored",
               "student_directed_ai_produced_student_verified",
               "ai_produced_not_verified", null],
      "description": "Records who wrote the code. Does not judge it."},
    "is_choice_level": {"type": "boolean",
      "description": "Evidence sits in a student-choice branch. Cap at introduced."},
    "choice_option": {"type": ["string", "null"]},
    "flags": {"type": "array", "items": {"$ref": "#/$defs/flag"}},
    "review_status": {"enum": ["proposed", "accepted", "rejected", "changed", "stale"]},
    "reviewed_by": {"type": ["string", "null"]},
    "reviewed_on": {"type": ["string", "null"], "format": "date-time"},
    "lesson_content_hash": {"type": "string", "minLength": 1,
      "description": "The hash at the time of the claim. Compare to detect staleness."}
  },
  "allOf": [{
    "if": {"properties": {"is_choice_level": {"const": true}}, "required": ["is_choice_level"]},
    "then": {"properties": {"level": {"const": "introduced"}},
             "required": ["choice_option"]}
  }],
  "$defs": {
    "flag": {
      "type": "object",
      "required": ["kind", "label"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["depth_doubt", "weak_match", "overclaim", "artifact_mismatch"]},
        "label": {"type": "string", "minLength": 1,
          "description": "Plain language. The interface prints this, not the kind."},
        "detail": {"type": ["string", "null"]}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standards-set.schema.json",
  "title": "Standards set",
  "description": "One standards document. The identity trio is required and has no default.",
  "type": "object",
  "required": ["id", "framework", "standard_set", "set_type", "framework_year",
               "title", "standard_count", "boundary_provenance", "publishable"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "integer"},
    "framework": {"type": "string", "minLength": 1,
      "description": "The issuing body. Required. Never defaulted to CSTA."},
    "standard_set": {"type": "string", "minLength": 1,
      "description": "Which document within that body. Required."},
    "set_type": {"enum": ["standards", "course_objectives"],
      "description": "Required."},
    "framework_year": {"type": "string", "minLength": 4,
      "description": "Text, not integer. Vintages read '2025-26'."},
    "title": {"type": "string", "minLength": 1},
    "source": {"type": ["string", "null"]},
    "scope": {"type": ["string", "null"]},
    "standard_count": {"type": "integer", "minimum": 0},
    "boundary_provenance": {"enum": ["source", "drafted", "drafted+reviewed"]},
    "publishable": {"type": "boolean",
      "description": "Computed. True only when provenance is drafted+reviewed."},
    "schema_notes": {"type": ["string", "null"]},
    "supersedes": {"type": ["integer", "null"]},
    "superseded_by": {"type": ["integer", "null"]},
    "reviewed_by": {"type": ["string", "null"]},
    "reviewed_on": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
